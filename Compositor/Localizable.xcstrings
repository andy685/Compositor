            "state": "translated",
            "value": "光"
          }
        }
      }
    },
    "Light blooming around the lines, like a CRT's phosphors": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "光线在线条周围绽放，就像 CRT 的荧光粉一样"
