    "Hide Compositor": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "隐藏合成器"
          }
        }
      }
    },
    "Hide Layer": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "隐藏层"
          }
        }
      }
