      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "限于选择"
          }
        }
      }
    },
    "Line height, baseline to baseline. Empty or 0 is Auto: 120% of the font size.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "线高、基线到基线。空或 0 表示自动：字体大小的 120%。"
