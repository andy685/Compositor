    "Lift the lines where the picture is bright, or lower them when negative, so they swell into its shapes": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "抬起图片明亮处的线条，或降低图片阴暗处的线条，使它们膨胀成其形状"
          }
        }
